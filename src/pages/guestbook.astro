---
export const prerender = false

import { actions } from 'astro:actions'
import GuestbookEntries from '../components/GuestbookEntries.astro'
import Layout from '../layouts/Layout.astro'

const result = Astro.getActionResult(actions.guestbook)
---

<Layout title="Guestbook | Aman Varshney">
	<section class="node">
		<h1>Guestbook</h1>
		<p class="text-muted mt-3 text-sm">Leave a message. It can be anything.</p>
	</section>

	<section class="node">
		<h2 class="node-label">sign</h2>
		{
			result?.error && (
				<p class="text-error mb-3 text-xs">
					{String(result?.error?.message ?? 'Something went wrong. Please try again.')}
				</p>
			)
		}
		<form
			method="POST"
			action={actions.guestbook}
			class="grid grid-cols-1 gap-3 md:grid-cols-[1fr_2fr_auto]"
		>
			<input type="text" name="name" placeholder="name" required minlength="2" maxlength="50" />
			<input
				type="text"
				name="message"
				placeholder="message"
				required
				minlength="2"
				maxlength="200"
			/>
			<button type="submit" class="px-2">sign</button>
		</form>
	</section>

	<section class="node">
		<h2 class="node-label">entries</h2>
		<GuestbookEntries server:defer>
			<div slot="fallback" class="space-y-3">
				<div class="bg-soft h-4 w-3/4 animate-pulse rounded-sm"></div>
				<div class="bg-soft h-4 w-2/3 animate-pulse rounded-sm"></div>
				<div class="bg-soft h-4 w-4/5 animate-pulse rounded-sm"></div>
				<div class="bg-soft h-4 w-3/5 animate-pulse rounded-sm"></div>
			</div>
		</GuestbookEntries>
	</section>
</Layout>
