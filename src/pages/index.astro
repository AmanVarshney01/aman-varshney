---
import Layout from '../layouts/Layout.astro'
import { funProjects, projects } from '../lib/projects'
---

<Layout title="Aman Varshney">
	<section class="node">
		<h1>Aman Varshney</h1>
		<p class="text-muted mt-3">
			Developer Advocate at Prisma. I made Better T Stack, a CLI that scaffolds 10k+ type-safe
			TypeScript projects every month. Open source, terminals, and everything AI, from India.
		</p>
	</section>

	<section class="node">
		<h2 class="node-label">work</h2>
		<div>
			<div class="flex items-baseline justify-between gap-4">
				<span class="text-bright font-mono text-sm">Prisma</span>
				<span class="text-muted font-mono text-xs">Developer Advocate</span>
			</div>
			<p class="text-muted text-sm">
				100+ pull requests across the Prisma CLI and open source, including{' '}
				<a href="https://github.com/prisma/create-prisma" target="_blank" rel="noopener"
					>create-prisma</a
				>, <a href="https://github.com/prisma/prisma-examples" target="_blank" rel="noopener"
					>prisma-examples</a
				> and <a href="https://github.com/prisma/skills" target="_blank" rel="noopener"
					>agent skills</a
				>.
			</p>
		</div>
	</section>

	<section class="node">
		<h2 class="node-label">projects</h2>
		<div class="space-y-4">
			{
				projects.map((project) => (
					<div>
						<div class="flex items-baseline justify-between gap-4">
							<span class="text-bright font-mono text-sm">{project.name}</span>
							<div class="flex gap-3 font-mono text-xs">
								{project.githubLink && (
									<a href={project.githubLink} target="_blank" rel="noopener">
										code
									</a>
								)}
								{project.liveLink && (
									<a href={project.liveLink} target="_blank" rel="noopener">
										live
									</a>
								)}
							</div>
						</div>
						<p class="text-muted text-sm">{project.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="node">
		<h2 class="node-label">memes that shipped</h2>
		<div class="space-y-4">
			{
				funProjects.map((project) => (
					<div>
						<div class="flex items-baseline justify-between gap-4">
							<span class="text-bright font-mono text-sm">{project.name}</span>
							<div class="flex gap-3 font-mono text-xs">
								{project.githubLink && (
									<a href={project.githubLink} target="_blank" rel="noopener">
										code
									</a>
								)}
								{project.liveLink && (
									<a href={project.liveLink} target="_blank" rel="noopener">
										live
									</a>
								)}
							</div>
						</div>
						<p class="text-muted text-sm">{project.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="node">
		<h2 class="node-label">elsewhere</h2>
		<div class="flex flex-wrap gap-4 font-mono text-sm">
			<a href="https://github.com/AmanVarshney01" target="_blank" rel="noopener">github</a>
			<a href="https://www.linkedin.com/in/amanvarshney11/" target="_blank" rel="noopener">
				linkedin
			</a>
			<a href="mailto:amanvarshney.work@gmail.com">email</a>
			<a href="https://cal.com/amanvarshney01/15min" target="_blank" rel="noopener">book a call</a>
		</div>
	</section>
</Layout>
