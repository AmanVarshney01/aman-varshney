{
	"main": "@astrojs/cloudflare/entrypoints/server",
	"name": "aman-varshney",
	"compatibility_date": "2026-04-15",
	"routes": [{ "pattern": "amanv.dev/*", "zone_name": "amanv.dev" }],
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"ratelimits": [
		{
			"name": "GUESTBOOK_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 2, "period": 60 }
		}
	],
	"observability": {
		"enabled": true
	}
}
