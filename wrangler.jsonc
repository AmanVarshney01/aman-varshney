{
	"main": "@astrojs/cloudflare/entrypoints/server",
	"name": "aman-varshney",
	"compatibility_date": "2026-04-15",
	"routes": [{ "pattern": "amanv.dev/*", "zone_name": "amanv.dev" }],
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	}
}
